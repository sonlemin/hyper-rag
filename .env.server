# Tham so moi truong may chu (8 vCPU / 15 GB) - KHONG chua secret (secret o .env goc).
# Dung: docker compose --env-file .env --env-file .env.server up -d
NEO4J_HEAP_INITIAL=1G
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=1G
POSTGRES_USER=hyperrag
POSTGRES_DB=hyperrag
OLLAMA_TAG=0.33.2
# Model cho wrapper LLM/embedding (story 2.2); ten phai co trong config/danh-muc-model.yaml
LLM_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_HOST=http://ollama:11434
