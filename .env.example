# Mau cho .env goc repo (gitignore) - CHI file nay chua secret.
# Copy thanh .env va dien gia tri that. Khong bao gio commit .env.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GITHUB_TOKEN=
NEO4J_PASSWORD=
POSTGRES_PASSWORD=
# Khoa ky JWT HS256 (story 3.1). KHONG co mac dinh va he KHONG tu sinh: thieu
# bien nay la tu choi khoi dong (ma JWT_SECRET_MISSING). Toi thieu 32 ky tu -
# HS256 lay nguyen chuoi lam khoa HMAC nen khoa ngan do duoc ngoai tuyen tu
# chinh token da phat. Sinh mot khoa: `openssl rand -base64 48`.
JWT_SECRET=
# Mat khau thuong cua ba tai khoan seed (`config/tai-khoan.yaml` chi chua hash
# bcrypt cost 12). Doi mat khau la sinh lai hash roi dan vao file do; khong co
# duong doi mat khau qua API trong pham vi khoa luan. Moi tai khoan trong seed
# phai co dung mot bien o day: `test_mat_khau_seed_that_dang_nhap_duoc` lap tren
# chinh seed, nen mot tai khoan khong co bien la mot tai khoan khong dang nhap
# duoc. `demo01` bat demo va tat admin - no la ca chung minh phep "demo HOAC
# admin" qua HTTP chu khong chi o muc unit.
DEMO_MAT_KHAU_TS01=
DEMO_MAT_KHAU_DEV01=
DEMO_MAT_KHAU_DEMO01=
# Qdrant trong docker-compose chay khong api-key (khong publish ra ngoai mang),
# nen de trong la dung. Bien rong tinh la chua dat: engine bo qua chu khong day
# mot chuoi rong xuong client.
QDRANT_API_KEY=
