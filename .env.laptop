# Tham so moi truong laptop duong lui R11 (4 nhan / 16 GB, khong local-llm) - KHONG chua secret.
# Dung: docker compose --env-file .env --env-file .env.laptop up -d
NEO4J_HEAP_INITIAL=512M
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512M
POSTGRES_USER=hyperrag
POSTGRES_DB=hyperrag
OLLAMA_TAG=0.33.2
# Model cho wrapper LLM/embedding (story 2.2); ten phai co trong config/danh-muc-model.yaml
LLM_MODEL=deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_HOST=http://ollama:11434
# Xac thuc JWT (story 3.1): khoa ky la SECRET nen no song trong `.env` goc
# repo duoi ten JWT_SECRET, khong o file nay. Compose khai no bang `:?` nen
# `docker compose ... config --quiet` do ngay neu `.env` thieu bien do.
# TTL token la hang 12 gio trong `api/xac_thuc.py`, khong phai tham so moi
# truong: mot quyet dinh bao mat doc tu moi truong la mot quyet dinh doi duoc
# ma khong ai xem lai diff.
